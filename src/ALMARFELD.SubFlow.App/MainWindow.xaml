<Window x:Class="ALMARFELD.SubFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ALMARFELD.SubFlow.App.ViewModels"
        xmlns:v="clr-namespace:ALMARFELD.SubFlow.App.Views"
        xmlns:l="clr-namespace:ALMARFELD.SubFlow.App.Services"
        Title="ALMARFELD SubFlow" Width="1320" Height="840" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}"
        Icon="Assets/subflow-64.png" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><v:SetupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideosViewModel}"><v:VideosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TranslationViewModel}"><v:TranslationView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}"><v:EditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QueueViewModel}"><v:QueueView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GlossaryViewModel}"><v:GlossaryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="Assets/subflow-64.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ALMARFELD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="SubFlow" FontSize="18" FontWeight="SemiBold" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Command="{Binding OpenUpdateCommand}" Margin="0,0,0,10" Padding="12,8"
                        HorizontalContentAlignment="Left" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding UpdateText}" FontSize="12" TextWrapping="Wrap" Width="150"/>
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Side_Engine}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Dashboard.ActiveEngine}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource Success}"/>
                            <TextBlock Text="{Binding Dashboard.PrivacyNote}" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap" Width="160"
                                       Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Nav}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Click="OnNavClick" Tag="{Binding Key}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </DockPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
            <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#CC0D1017" BorderBrush="{StaticResource Accent}"
                    BorderThickness="2" CornerRadius="12" Margin="16" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="{l:Loc Drop_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Loc Drop_Hint}" Style="{StaticResource Subtle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
