<UserControl x:Class="ALMARFELD.SubFlow.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ALMARFELD.SubFlow.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,30" MaxWidth="1200">
            <TextBlock Text="{l:Loc Dash_Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:Loc Dash_Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,24"/>

            <!-- Workflow -->
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style x:Key="StepNum" TargetType="Border">
                            <Setter Property="Width" Value="28"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="CornerRadius" Value="14"/>
                            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                        <Style x:Key="Arrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                            <Setter Property="Text" Value="&#xE76C;"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="14,0"/>
                        </Style>
                    </Grid.Resources>
                    <StackPanel>
                        <Border Style="{StaticResource StepNum}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="{l:Loc Dash_Step1}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,10"><Run Text="{Binding Videos.Count, Mode=OneWay}"/> <Run Text="{l:Loc Dash_VideosLoaded}"/></TextBlock>
                        <Button Content="{l:Loc Dash_GoVideos}" Command="{Binding GoCommand}" CommandParameter="Videos" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Arrow}"/>
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource StepNum}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="{l:Loc Dash_Step2}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TargetLanguages}" Style="{StaticResource Subtle}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                        <Button Content="{l:Loc Dash_GoLanguages}" Command="{Binding GoCommand}" CommandParameter="Translation" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource Arrow}"/>
                    <StackPanel Grid.Column="4">
                        <Border Style="{StaticResource StepNum}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="{l:Loc Dash_Step3}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveEngine}" Style="{StaticResource Subtle}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>
                        <Button Content="{l:Loc Dash_GoEngine}" Command="{Binding GoCommand}" CommandParameter="Translation" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock Grid.Column="5" Style="{StaticResource Arrow}"/>
                    <StackPanel Grid.Column="6">
                        <Border Style="{StaticResource StepNum}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="{l:Loc Dash_Step4}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Queue.StateText}" Style="{StaticResource Subtle}" Margin="0,2,0,10"/>
                        <Button Content="{l:Loc Dash_GoStart}" Style="{StaticResource PrimaryButton}" Command="{Binding Translation.StartCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats -->
            <UniformGrid Columns="4" Margin="-6,0,-6,18">
                <UniformGrid.Resources>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Margin" Value="6,0"/>
                    </Style>
                </UniformGrid.Resources>
                <Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Waiting}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Queue.Waiting}" FontSize="30" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Completed}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Queue.Completed}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Errors}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Queue.Failed}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
                    </StackPanel>
                </Border>
                <Border>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Dash_Languages}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Translation.SelectedTargets.Count}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Teal}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Progress -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Queue.OverallProgress, StringFormat={}{0:0}%}" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{l:Loc Dash_Progress}" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding Queue.OverallProgress, Mode=OneWay}" Maximum="100" Height="8"/>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Queue.Eta}" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding Queue.StateText}" Foreground="{StaticResource TextMuted}"/>
                    </DockPanel>
                    <Border Background="{StaticResource WarningSoft}" CornerRadius="7" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding Queue.HasInterrupted, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Dash_Resume}" Command="{Binding Queue.StartCommand}"/>
                            <TextBlock Text="{l:Loc Dash_Interrupted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Health -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RefreshHealthCommand}" ToolTip="{l:Loc Common_Refresh}">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        </Button>
                        <TextBlock Text="{l:Loc Dash_Health}" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Health}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="G" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Success}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Subtle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="{Binding ActionLabel}" Command="{Binding Action}" CommandParameter="{Binding ActionParameter}"
                                            Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center"
                                            Visibility="{Binding HasAction, Converter={StaticResource Vis}}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="missing">
                                        <Setter TargetName="G" Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="optional">
                                        <Setter TargetName="G" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{l:Loc Dash_HealthHelp}" Style="{StaticResource Subtle}" Margin="0,10,0,0"
                               Visibility="{Binding HasHealthProblems, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
