<UserControl x:Class="ALMARFELD.SubFlow.App.Views.TranslationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ALMARFELD.SubFlow.App.Services">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
            <TextBlock Text="{l:Loc Nav_Translation}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:Loc Tr_Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Languages -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{l:Loc Tr_Source}" Style="{StaticResource H2}"/>
                    <ComboBox ItemsSource="{Binding SourceOptions}" SelectedValuePath="Code" DisplayMemberPath="Display"
                              SelectedValue="{Binding SourceLanguage}" MaxDropDownHeight="360"/>
                    <TextBlock Text="{l:Loc Tr_SourceHint}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,6,0,18"/>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Loc Common_ClearAll}" Command="{Binding ClearTargetsCommand}"/>
                        <TextBlock Text="{l:Loc Tr_Targets}" Style="{StaticResource H2}"/>
                    </DockPanel>

                    <!-- Selected chips -->
                    <ItemsControl ItemsSource="{Binding SelectedTargets}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentSoft}" CornerRadius="12" Padding="10,3,4,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Language.Name}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource GhostButton}" Padding="6,0" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TargetsSummary}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
                <ListBox ItemsSource="{Binding TargetsView}" MinHeight="140">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}"/>
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextFaint}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="RTL" Foreground="{StaticResource Teal}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                               Visibility="{Binding Language.IsRightToLeft, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Engine + output -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Tr_Engine}" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChoiceButton}" GroupName="engine" Tag="{Binding Id}"
                                                 Checked="OnEngineChecked" Loaded="OnEngineLoaded">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="6,0" x:Name="Badge" Background="{StaticResource SuccessSoft}">
                                                    <TextBlock x:Name="BadgeText" Text="{l:Loc Tr_Free}" FontSize="10" Foreground="{StaticResource Success}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCloud}" Value="True">
                                            <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarningSoft}"/>
                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Warning}"/>
                                            <Setter TargetName="BadgeText" Property="Text" Value="{l:Loc Tr_Cloud}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ollama -->
                        <StackPanel Visibility="{Binding IsOllama, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <TextBlock Text="{l:Loc Tr_Model}" Style="{StaticResource Caption}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding RefreshModelsCommand}" ToolTip="{l:Loc Common_Refresh}">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                </Button>
                                <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Display"/>
                            </DockPanel>
                            <TextBlock Text="{Binding OllamaStatus}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Border Margin="0,12,0,0" CornerRadius="7" Padding="12,9">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCloudEngine}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource WarningSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding EngineNote}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Tr_Output}" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <RadioButton Style="{StaticResource ChoiceButton}" GroupName="out"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumEq}, ConverterParameter=Mkv}">
                                <TextBlock Text="{l:Loc Tr_OutMkv}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceButton}" GroupName="out"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumEq}, ConverterParameter=MkvAndSubtitleFiles}">
                                <TextBlock Text="{l:Loc Tr_OutBoth}"/>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceButton}" GroupName="out"
                                         IsChecked="{Binding OutputMode, Converter={StaticResource EnumEq}, ConverterParameter=SubtitleFiles}">
                                <TextBlock Text="{l:Loc Tr_OutFiles}"/>
                            </RadioButton>
                        </WrapPanel>

                        <TextBlock Text="{l:Loc Tr_OutputFolder}" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:Loc Tr_Default}" Command="{Binding ClearOutputCommand}" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="{l:Loc Common_Browse}" Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0"/>
                            <Border Background="{StaticResource Surface2}" CornerRadius="7" Padding="10,7">
                                <TextBlock Text="{Binding OutputFolderDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolderDisplay}"/>
                            </Border>
                        </DockPanel>
                        <CheckBox Content="{l:Loc Tr_PreserveStructure}" IsChecked="{Binding PreserveFolderStructure}" Margin="0,12,0,0"/>

                        <TextBlock Text="{l:Loc Tr_ExistingTrack}" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ExistingTrackPolicy}">
                            <ComboBoxItem Tag="{x:Static l:Enums.TrackSkip}" Content="{l:Loc Tr_TrackSkip}"/>
                            <ComboBoxItem Tag="{x:Static l:Enums.TrackKeepBoth}" Content="{l:Loc Tr_TrackKeepBoth}"/>
                            <ComboBoxItem Tag="{x:Static l:Enums.TrackReplace}" Content="{l:Loc Tr_TrackReplace}"/>
                        </ComboBox>

                        <TextBlock Text="{l:Loc Tr_ExistingOutput}" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ExistingOutputPolicy}">
                            <ComboBoxItem Tag="{x:Static l:Enums.OutSkip}" Content="{l:Loc Tr_OutSkip}"/>
                            <ComboBoxItem Tag="{x:Static l:Enums.OutRename}" Content="{l:Loc Tr_OutRename}"/>
                            <ComboBoxItem Tag="{x:Static l:Enums.OutOverwrite}" Content="{l:Loc Tr_OutOverwrite}"/>
                        </ComboBox>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tr_Concurrency}" Style="{StaticResource Caption}"/>
                                <ComboBox ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding Concurrency}" Width="90" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{l:Loc Tr_ConcurrencyHint}" Style="{StaticResource Subtle}" FontSize="11" Margin="14,18,0,0"/>
                        </Grid>
                        <CheckBox Content="{l:Loc Tr_MakeDefault}" IsChecked="{Binding MakeFirstNewTrackDefault}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Start bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Padding="22,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Loc Tr_Start}" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoSummary}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TargetsSummary}" Style="{StaticResource Subtle}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
