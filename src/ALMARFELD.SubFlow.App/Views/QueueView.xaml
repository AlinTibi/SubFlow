<UserControl x:Class="ALMARFELD.SubFlow.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ALMARFELD.SubFlow.App.Services">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Loc Queue_Start}" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PauseCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Loc Queue_PauseResume}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:Loc Common_Cancel}" Foreground="{StaticResource Danger}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RetryFailedCommand}" Content="{l:Loc Queue_RetryFailed}" Margin="0,0,8,0"/>
                <Button Command="{Binding RemoveWaitingCommand}" Content="{l:Loc Queue_RemoveWaiting}" Margin="0,0,8,0"/>
                <Button Command="{Binding ClearFinishedCommand}" Style="{StaticResource GhostButton}" Content="{l:Loc Queue_ClearFinished}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Loc Nav_Queue}" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0">
                    <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource Text}"/> ·
                    <Run Text="{Binding EngineText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasNotice, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Eta}" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock>
                        <Run Text="{Binding Completed, Mode=OneWay}" Foreground="{StaticResource Success}"/> <Run Text="{l:Loc Queue_Done}"/> ·
                        <Run Text="{Binding Waiting, Mode=OneWay}"/> <Run Text="{l:Loc Queue_Waiting}"/> ·
                        <Run Text="{Binding Skipped, Mode=OneWay}"/> <Run Text="{l:Loc Queue_Skipped}"/> ·
                        <Run Text="{Binding Failed, Mode=OneWay}" Foreground="{StaticResource Danger}"/> <Run Text="{l:Loc Queue_Failed}"/>
                    </TextBlock>
                </DockPanel>
                <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Maximum="100" Height="8"/>
                <TextBlock Text="{l:Loc Queue_Hint}" Foreground="{StaticResource TextFaint}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <TextBlock Text="{l:Loc Queue_Empty}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Items.Count, Converter={StaticResource NotVis}}"/>
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" SelectionMode="Extended"
                         KeyDown="OnListKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Common_ShowInFolder}" Click="OnShowInFolder"/>
                            <MenuItem Header="{l:Loc Queue_Retry}" Click="OnRetrySelected"/>
                            <Separator/>
                            <MenuItem Header="{l:Loc Queue_RemoveSelected}" InputGestureText="Del" Click="OnRemoveSelected"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" Margin="0,3,0,0" ToolTip="{Binding Message}"/>
                                    <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource Warning}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}" MaxHeight="48" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Warnings}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Languages}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" ToolTip="{l:Loc Common_ShowInFolder}"
                                            Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" ToolTip="{l:Loc Queue_Retry}"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" ToolTip="{l:Loc Common_Remove}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
