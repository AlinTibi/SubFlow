<UserControl x:Class="ALMARFELD.SubFlow.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ALMARFELD.SubFlow.App.Services">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Content="{l:Loc Common_Refresh}" Margin="0,0,8,0"/>
                <Button Command="{Binding ExportCommand}" Content="{l:Loc Hist_Export}" Margin="0,0,8,0"/>
                <Button Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" Content="{l:Loc Hist_Clear}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{l:Loc Nav_History}" Style="{StaticResource H1}"/>
                <TextBlock Text="{l:Loc Hist_Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Loc Hist_ColFile}" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTemplateColumn Header="{l:Loc Hist_ColStatus}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Loc Hist_ColLanguages}" Binding="{Binding Languages}" Width="*"/>
                <DataGridTextColumn Header="{l:Loc Hist_ColEngine}" Binding="{Binding Engine}" Width="1.6*"/>
                <DataGridTextColumn Header="{l:Loc Hist_ColDuration}" Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="{l:Loc Hist_ColWhen}" Binding="{Binding When}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Selected, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Loc Common_ShowInFolder}" Command="{Binding OpenOutputCommand}" VerticalAlignment="Top"/>
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Item.SourcePath}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding OutputPath}" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,8"/>
                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
