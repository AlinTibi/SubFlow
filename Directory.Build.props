<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.2.2</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
    <InformationalVersion>1.2.2</InformationalVersion>
    <Company>ALMARFELD</Company>
    <Authors>ALMARFELD</Authors>
    <Product>ALMARFELD SubFlow</Product>
    <Copyright>Copyright © 2026 ALMARFELD</Copyright>
    <PackageProjectUrl>https://almarfeld.com</PackageProjectUrl>
    <!-- GitHub repository, e.g. https://github.com/owner/subflow. Enables the About links and update checks. -->
    <RepositoryUrl>https://github.com/AlinTibi/SubFlow</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;ro</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
